NEXT_PUBLIC_APP_URL=https://tu-dominio-final.com
INTERNAL_APP_URL=https://tu-dominio-final.com
NEXT_PUBLIC_DB_PROVIDER=supabase

# Meta / Facebook / WhatsApp
NEXT_PUBLIC_META_APP_ID=
NEXT_PUBLIC_META_CONFIG_ID=
NEXT_PUBLIC_META_GRAPH_VERSION=v21.0
META_APP_ID=
META_APP_SECRET=
META_FACEBOOK_CONFIG_ID=
META_GRAPH_VERSION=v21.0
META_WEBHOOK_VERIFY_TOKEN=
FACEBOOK_APP_SECRET=

# Supabase
# Fill these with the project values from Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional integrations used by some screens / flows
NEXT_PUBLIC_INSTAGRAM_LOGIN_URL=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
NEXT_PUBLIC_FACEBOOK_APP_ID=
NEXT_PUBLIC_WHATSAPP_CONFIG_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
ANTHROPIC_API_KEY=
RESPOND_IO_API_BASE=https://api.respond.io/v2

# ePayco
NEXT_PUBLIC_EPAYCO_PUBLIC_KEY=
EPAYCO_PRIVATE_KEY=
EPAYCO_CUSTOMER_ID=
EPAYCO_P_KEY=
# First production deployment must still use the provider sandbox.
EPAYCO_TEST=true

# Keep off until prices, entitlements, usage and regression tests are approved.
BILLING_ENFORCEMENT_MODE=hard
BILLING_GRACE_DAYS=3
# Set to on only after migration 031 is applied and concurrency tests pass.
BILLING_ATOMIC_QUOTA_MODE=off

# Set each gateway environment explicitly. Keep renewals manual for the first
# production rollout.
PAYMENT_GATEWAY_DEFAULT=epayco
PAYMENT_ENVIRONMENT=sandbox
PAYMENT_RENEWAL_MODE=manual
PAYMENT_AUTO_RENEWAL_APPROVED=false

# Wompi
# Configuration can be stored now, but checkout remains blocked until its
# activation webhook is implemented and certified.
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
WOMPI_ENVIRONMENT=sandbox

# PayU Latam
# Configuration can be stored now, but checkout remains blocked until its
# confirmation webhook is implemented and certified.
PAYU_API_LOGIN=
PAYU_API_KEY=
PAYU_MERCHANT_ID=
PAYU_ACCOUNT_ID=
PAYU_ENVIRONMENT=sandbox

# Vercel Cron
CRON_SECRET=

# Transcripción de audios y videos entrantes para el agente de IA con OpenAI
# (Claude no acepta audio/video). Sin esta llave el agente pide al cliente que escriba.
OPENAI_API_KEY=
# Opcional: modelo de transcripción (por defecto gpt-4o-transcribe)
OPENAI_TRANSCRIBE_MODEL=
# Opcional: modelo para leer imágenes/PDF entrantes (por defecto claude-opus-5)
CHATBOT_MEDIA_MODEL=

# Webhook de Cal.com (Settings → Developer → Webhooks → Secret). Recibe reservas en /api/webhook/calcom
CALCOM_WEBHOOK_SECRET=
CALCOM_DEFAULT_TIMEZONE=America/Bogota
