NEXT_PUBLIC_APP_URL=http://localhost:3000
INTERNAL_APP_URL=http://localhost:3000
NEXT_PUBLIC_DB_PROVIDER=supabase
NEXT_PUBLIC_META_APP_ID=
NEXT_PUBLIC_META_CONFIG_ID=
NEXT_PUBLIC_META_GRAPH_VERSION=v21.0
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v21.0
META_WEBHOOK_VERIFY_TOKEN=

# Local PostgREST
NEXT_PUBLIC_POSTGREST_URL=http://localhost:3001
NEXT_PUBLIC_POSTGREST_API_KEY=

# Local MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=comunity_manager

# Supabase (Community CM_* tablas + schema smarttalk inbox)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp / Meta (inbox SmartTalk + CM)
NEXT_PUBLIC_FACEBOOK_APP_ID=
NEXT_PUBLIC_FACEBOOK_CONFIG_ID=
FACEBOOK_APP_SECRET=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# AI inbox
ANTHROPIC_API_KEY=

# Skills injection mode: retrieval (default), tools, off
SKILLS_MODE=retrieval

# Respond.io
RESPOND_IO_API_BASE=https://api.respond.io/v2

# ePayco
NEXT_PUBLIC_EPAYCO_PUBLIC_KEY=
EPAYCO_PRIVATE_KEY=
EPAYCO_CUSTOMER_ID=
EPAYCO_P_KEY=
EPAYCO_TEST=true

# Billing enforcement: off | observe | soft | hard
BILLING_ENFORCEMENT_MODE=off
BILLING_GRACE_DAYS=3

# Billing multi-gateway. Keep renewal manual until tokenization is contracted
# and approved with each provider.
PAYMENT_GATEWAY_DEFAULT=epayco
PAYMENT_ENVIRONMENT=sandbox
PAYMENT_RENEWAL_MODE=manual
PAYMENT_AUTO_RENEWAL_APPROVED=false

# Wompi
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
WOMPI_ENVIRONMENT=sandbox

# PayU Latam
PAYU_API_LOGIN=
PAYU_API_KEY=
PAYU_MERCHANT_ID=
PAYU_ACCOUNT_ID=
PAYU_ENVIRONMENT=sandbox

# Cron (Vercel)
CRON_SECRET=

# Token encryption (Sprint 22)
# 32 bytes base64 (o hex). REQUIRED — cifra access_token de channels y cm_social_accounts.
# Generate: openssl rand -base64 32   (o: openssl rand -hex 32)
# Alias aceptado por el wrapper @/lib/crypto: ENCRYPTION_KEY (cae a TOKEN_ENCRYPTION_KEY si sólo esa está).
TOKEN_ENCRYPTION_KEY=
# ENCRYPTION_KEY=  # alias opcional, solo si prefieres el nombre del spec

# Inngest (Sprint 22 · scheduling engine)
# Dev: opcionales — `npx inngest-cli dev` corre local en :8288 y firma automáticamente.
# Prod: AMBAS obligatorias (event key para publicar eventos, signing key para validar webhooks).
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Sprint 24 · Social publish channels
# TikTok for Business — Content Posting API
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://comunitymanager.io/api/social/oauth/tiktok/callback

# LinkedIn — versioned Posts API (LinkedIn-Version: 202506)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://comunitymanager.io/api/social/oauth/linkedin/callback

# Threads (reuses META_APP_ID / META_APP_SECRET; only needs its own redirect URI)
THREADS_REDIRECT_URI=https://comunitymanager.io/api/social/oauth/threads/callback
