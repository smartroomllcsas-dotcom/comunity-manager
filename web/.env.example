NEXT_PUBLIC_APP_URL=http://localhost:3000
INTERNAL_APP_URL=http://localhost:3000
NEXT_PUBLIC_DB_PROVIDER=supabase
NEXT_PUBLIC_META_APP_ID=
NEXT_PUBLIC_META_CONFIG_ID=
NEXT_PUBLIC_META_GRAPH_VERSION=v21.0
META_APP_ID=
META_APP_SECRET=
META_FACEBOOK_CONFIG_ID=
META_GRAPH_VERSION=v21.0
META_WEBHOOK_VERIFY_TOKEN=

# Local PostgREST
NEXT_PUBLIC_POSTGREST_URL=http://localhost:3001
NEXT_PUBLIC_POSTGREST_API_KEY=

# Local MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=comunity_manager

# Supabase (Community CM_* tablas + schema smarttalk inbox)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp / Meta (inbox SmartTalk + CM)
NEXT_PUBLIC_FACEBOOK_APP_ID=
NEXT_PUBLIC_FACEBOOK_CONFIG_ID=
FACEBOOK_APP_SECRET=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# AI inbox
ANTHROPIC_API_KEY=

# Skills injection mode: retrieval (default), tools, off
SKILLS_MODE=retrieval

# Respond.io
RESPOND_IO_API_BASE=https://api.respond.io/v2

# ePayco
NEXT_PUBLIC_EPAYCO_PUBLIC_KEY=
EPAYCO_PRIVATE_KEY=
EPAYCO_CUSTOMER_ID=
EPAYCO_P_KEY=
EPAYCO_TEST=true

# Billing enforcement: off | observe | soft | hard
BILLING_ENFORCEMENT_MODE=off
BILLING_GRACE_DAYS=3
# Enable only after migration 031 is applied and verified in the target DB.
BILLING_ATOMIC_QUOTA_MODE=off

# Billing multi-gateway. Keep renewal manual until tokenization is contracted
# and approved with each provider.
PAYMENT_GATEWAY_DEFAULT=epayco
PAYMENT_ENVIRONMENT=sandbox
PAYMENT_RENEWAL_MODE=manual
PAYMENT_AUTO_RENEWAL_APPROVED=false

# Wompi
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
WOMPI_ENVIRONMENT=sandbox

# PayU Latam
PAYU_API_LOGIN=
PAYU_API_KEY=
PAYU_MERCHANT_ID=
PAYU_ACCOUNT_ID=
PAYU_ENVIRONMENT=sandbox

# Notion OAuth (Sprint 2 · S2-10)
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_OAUTH_REDIRECT_URL=https://<host>/api/os/connectors/notion/callback

# Cron (Vercel)
CRON_SECRET=

# Token encryption (Sprint 22)
# 32 bytes base64 (o hex). REQUIRED — cifra access_token de channels y cm_social_accounts.
# Generate: openssl rand -base64 32   (o: openssl rand -hex 32)
# Alias aceptado por el wrapper @/lib/crypto: ENCRYPTION_KEY (cae a TOKEN_ENCRYPTION_KEY si sólo esa está).
TOKEN_ENCRYPTION_KEY=
# ENCRYPTION_KEY=  # alias opcional, solo si prefieres el nombre del spec

# Inngest (Sprint 22 · scheduling engine)
# Dev: opcionales — `npx inngest-cli dev` corre local en :8288 y firma automáticamente.
# Prod: AMBAS obligatorias (event key para publicar eventos, signing key para validar webhooks).
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Sprint 24 · Social publish channels
# TikTok for Business — Content Posting API
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://comunitymanager.io/api/social/oauth/tiktok/callback

# LinkedIn — versioned Posts API (LinkedIn-Version: 202506)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://comunitymanager.io/api/social/oauth/linkedin/callback

# Threads (reuses META_APP_ID / META_APP_SECRET; only needs its own redirect URI)
THREADS_REDIRECT_URI=https://comunitymanager.io/api/social/oauth/threads/callback

# Sprint 25 · Additional social publish channels
# YouTube (usa Google Cloud project)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=https://comunitymanager.io/api/social/oauth/youtube/callback

# Google Business Profile (mismo Google Cloud project posible)
GBP_CLIENT_ID=
GBP_CLIENT_SECRET=
GBP_REDIRECT_URI=https://comunitymanager.io/api/social/oauth/gbp/callback

# Pinterest
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
PINTEREST_REDIRECT_URI=https://comunitymanager.io/api/social/oauth/pinterest/callback

# Sprint 25 · Client approval workflow (magic-link portal público sin auth)
# 32 bytes hex mínimo. Genera: openssl rand -hex 32. Fallback a CRON_SECRET si vacío.
APPROVAL_HMAC_SECRET=
# Sistema WhatsApp para enviar magic-links (opcional; si vacío, la notif WA queda como stub logged)
WHATSAPP_SYSTEM_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Sprint 25 · Analytics (Agente K)
# GA4 opcional — sin estas vars el provider ga4 se desactiva silenciosamente.
# Genera el service account en Google Cloud → IAM → Service Accounts, dale rol
# "Viewer" en la propiedad GA4, descarga JSON y copia los campos:
GOOGLE_ANALYTICS_PROPERTY_ID=
GOOGLE_ANALYTICS_CLIENT_EMAIL=
GOOGLE_ANALYTICS_PRIVATE_KEY=
# LinkedIn REST API version header (mensual, formato YYYYMM). Default: 202410
LINKEDIN_API_VERSION=

# Sprint 26 · Notifications (Agente Q)
# Resend — transactional email. Free tier: 3k emails/mo, 100/day.
# Sin RESEND_API_KEY el canal email retorna {ok:false, error:'RESEND_API_KEY not configured'} (no throw).
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@comunitymanager.io
# Slack — dos modos soportados, uno o ambos:
#   1) Incoming webhook (más simple; solo publica en el canal del webhook)
#   2) Bot token (soporta chat.postMessage a cualquier canal donde el bot esté)
SLACK_WEBHOOK_URL=
SLACK_BOT_TOKEN=

# Sprint 2 (S2-09) · Slack OAuth connector (FounderOS integrations)
# Create a Slack app at https://api.slack.com/apps → OAuth & Permissions
# Add redirect URL: https://<host>/api/os/connectors/slack/callback (and http://localhost:3000/... for dev)
# Required bot token scopes: chat:write, chat:write.public, channels:read, team:read
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Dev:  SLACK_OAUTH_REDIRECT_URL=http://localhost:3000/api/os/connectors/slack/callback
# Prod: SLACK_OAUTH_REDIRECT_URL=https://www.comunitymanager.io/api/os/connectors/slack/callback
SLACK_OAUTH_REDIRECT_URL=http://localhost:3000/api/os/connectors/slack/callback
# WHATSAPP_SYSTEM_TOKEN y WHATSAPP_PHONE_NUMBER_ID ya declarados en Sprint 25 (reutilizados
# por whatsapp-templates.ts para enviar templates pre-aprobados de Meta Business Manager).

# Sprint 26 · Media pipeline (Supabase Storage + Fal.ai)
# ---------------------------------------------------------------------------
# Fal.ai API key para generacion de imagenes (flux-pro) y videos (kling-video).
# Sin esta var, POST /api/media/generate responde 503 { ok:false, error:'FAL_KEY not configured' }
# — upload manual sigue funcionando. Get key: https://fal.ai/dashboard/keys
FAL_KEY=

# Bucket de Supabase Storage. Crearlo (public read) con: supabase storage bucket create cm-assets --public
SUPABASE_STORAGE_BUCKET=cm-assets

# Sprint 26 · Agente S · Onboarding wizard (magic-link self-service para clientes)
# ---------------------------------------------------------------------------
# 32 bytes hex minimo. Genera: openssl rand -hex 32. Fallback a CRON_SECRET si vacio.
# Firma tokens de invite en cm_onboarding_state.invite_token_hash — cliente completa
# su propio onboarding via /onboard/<token> sin necesidad de crear cuenta.
ONBOARDING_HMAC_SECRET=
